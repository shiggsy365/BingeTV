diff --git a/xbmc/platform/android/ApkLibs.h b/xbmc/platform/android/ApkLibs.h
new file mode 100644
index 0000000..e32fc59
--- /dev/null
+++ b/xbmc/platform/android/ApkLibs.h
@@ -0,0 +1,54 @@
+/*
+ *  Copyright (C) 2026 BingeTV
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// BingeTV: the native libraries stay inside the APK instead of being unpacked on install (they
+// are stored uncompressed and page-aligned, and the dynamic linker loads them from there),
+// which saves their size again on the device. Their paths then look like
+// /data/app/<package>/base.apk!/lib/<abi>/libX.so, which the file system can't see, so whether
+// one is there is asked of the dynamic linker.
+
+#include <string>
+
+#include <dlfcn.h>
+
+namespace KODI::APKLIBS
+{
+inline bool IsApkLibPath(const std::string& path)
+{
+  return path.find(".apk!/") != std::string::npos;
+}
+
+inline bool ApkLibExists(const std::string& path)
+{
+  if (!IsApkLibPath(path))
+    return false;
+  void* handle = dlopen(path.c_str(), RTLD_LAZY | RTLD_NOLOAD);
+  if (handle == nullptr)
+    handle = dlopen(path.c_str(), RTLD_LAZY);
+  if (handle == nullptr)
+    return false;
+  dlclose(handle);
+  return true;
+}
+
+// The ABI folder of the APK's libraries this build is for
+inline const char* ApkLibAbi()
+{
+#if defined(__aarch64__)
+  return "arm64-v8a";
+#elif defined(__arm__)
+  return "armeabi-v7a";
+#elif defined(__x86_64__)
+  return "x86_64";
+#else
+  return "x86";
+#endif
+}
+} // namespace KODI::APKLIBS
