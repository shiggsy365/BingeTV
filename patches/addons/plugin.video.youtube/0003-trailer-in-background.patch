+
+
+_BINGETV_PROPS = (
+    'inputstream',
+    'inputstream.adaptive.manifest_headers',
+    'inputstream.adaptive.stream_headers',
+    'inputstream.adaptive.stream_selection_type',
+    'inputstream.adaptive.chooser_resolution_max',
+    'inputstream.adaptive.config',
+)
+
+
+def _bingetv_trailer_stream(item):
+    """BingeTV: the resolved trailer for its Home (Window(Home).Property(bingetv.trailer_stream))."""
+    from json import dumps
+
+    path = item.getPath()
+    props = {key: item.getProperty(key) for key in _BINGETV_PROPS if item.getProperty(key)}
+    if props.get('inputstream'):
+        mime = 'application/x-mpegURL'
+    elif 'mime=' in path:
+        mime = path.split('mime=', 1)[1].split('&', 1)[0].replace('%2F', '/')
+    else:
+        mime = ''
+    xbmcgui.Window(10000).setProperty('bingetv.trailer_stream', dumps({
+        'path': path, 'props': props, 'mime': mime,
+    }))
