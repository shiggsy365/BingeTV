+// BingeTV: profiles made and changed from its own profile picker (Stremio Bridge), in one step
+// rather than through Kodi's profile dialogs.
+
+/*! \brief Add a profile: BingeTV.AddProfile(name[,thumb[,directory]])
+ *  The directory (relative to the master profile's, e.g. "profiles/kids/") defaults to one
+ *  made from the name. The new profile starts with the master profile's Kodi settings
+ *  (guisettings.xml) and its own add-on data, databases and sources. */
+static int AddProfile(const std::vector<std::string>& params)
+{
+  const std::shared_ptr<CProfileManager> profileManager =
+      CServiceBroker::GetSettingsComponent()->GetProfileManager();
+  const std::string& name = params[0];
+  if (name.empty() || profileManager->GetProfileIndex(name) != INVALID_PROFILE_ID)
+    return -1;
+
+  std::string directory = params.size() > 2 && !params[2].empty()
+                              ? params[2]
+                              : URIUtils::AddFileToFolder("profiles", CUtil::MakeLegalFileName(name));
+  URIUtils::AddSlashAtEnd(directory);
+  const std::string path = URIUtils::AddFileToFolder("special://masterprofile/", directory);
+  if (!XFILE::CDirectory::Exists(path) && !XFILE::CDirectory::Create(path))
+    return -1;
+
+  const std::string settings = URIUtils::AddFileToFolder(path, "guisettings.xml");
+  if (!XFILE::CFile::Exists(settings))
+    XFILE::CFile::Copy("special://masterprofile/guisettings.xml", settings);
+
+  CProfile profile(directory, name, profileManager->GetNextProfileId());
+  if (params.size() > 1)
+    profile.setThumb(params[1]);
+  profile.setDate();
+  profileManager->AddProfile(profile); // saves profiles.xml
+  return 0;
+}
+
+/*! \brief Change a profile's picture: BingeTV.SetProfileThumb(name,thumb) */
+static int SetProfileThumb(const std::vector<std::string>& params)
+{
+  const std::shared_ptr<CProfileManager> profileManager =
+      CServiceBroker::GetSettingsComponent()->GetProfileManager();
+  const int index = profileManager->GetProfileIndex(params[0]);
+  if (index == INVALID_PROFILE_ID)
+    return -1;
+  CProfile* profile = profileManager->GetProfile(index);
+  if (profile == nullptr)
+    return -1;
+  profile->setThumb(params.size() > 1 ? params[1] : "");
+  profileManager->Save();
+  return 0;
+}
+
+/*! \brief Rename a profile: BingeTV.RenameProfile(name,new name) */
+static int RenameProfile(const std::vector<std::string>& params)
+{
+  const std::shared_ptr<CProfileManager> profileManager =
+      CServiceBroker::GetSettingsComponent()->GetProfileManager();
+  if (params.size() < 2 || params[1].empty() ||
+      profileManager->GetProfileIndex(params[1]) != INVALID_PROFILE_ID)
+    return -1;
+  const int index = profileManager->GetProfileIndex(params[0]);
+  CProfile* profile = index == INVALID_PROFILE_ID ? nullptr : profileManager->GetProfile(index);
+  if (profile == nullptr)
+    return -1;
+  profile->setName(params[1]);
+  profileManager->Save();
+  return 0;
+}
+
+/*! \brief Delete a profile (not the master profile, nor the one in use), asking whether its
+ *  files go too: BingeTV.DeleteProfile(name) */
+static int DeleteProfile(const std::vector<std::string>& params)
+{
+  const std::shared_ptr<CProfileManager> profileManager =
+      CServiceBroker::GetSettingsComponent()->GetProfileManager();
+  const int index = profileManager->GetProfileIndex(params[0]);
+  if (index == INVALID_PROFILE_ID || index == 0 ||
+      static_cast<uint32_t>(index) == profileManager->GetCurrentProfileIndex())
+    return -1;
+  return profileManager->DeleteProfile(index) ? 0 : -1;
+}
+
+/*! \brief Show the profile picker (login screen) when Kodi starts: BingeTV.UseLoginScreen(true|false) */
+static int UseLoginScreen(const std::vector<std::string>& params)
+{
+  const std::shared_ptr<CProfileManager> profileManager =
+      CServiceBroker::GetSettingsComponent()->GetProfileManager();
+  const bool wanted = StringUtils::EqualsNoCase(params[0], "true");
+  if (profileManager->UsingLoginScreen() != wanted)
+    profileManager->ToggleLoginScreen(); // saves profiles.xml
+  return 0;
+}
