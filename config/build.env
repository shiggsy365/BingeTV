# What BingeTV is built from. scripts/build-android.sh and the CI workflow read this file.

# Kodi release the build is based on (a tag of https://github.com/xbmc/xbmc).
KODI_REPO=https://github.com/xbmc/xbmc.git
KODI_TAG=22.0rc1-Piers

# Android toolchain, as Kodi 22's docs/README.Android.md asks for.
ANDROID_NDK_VERSION=28.2.13676358
ANDROID_PLATFORM="platforms;android-37.0"
ANDROID_BUILD_TOOLS="build-tools;37.0.0"

# Binary add-ons built into the APK (https://github.com/xbmc/repo-binary-addons).
# inputstream.adaptive: HLS/DASH streams; inputstream.ffmpegdirect: IPTV catch-up and
# raw streams; inputstream.rtmp: RTMP streams (pvr.iptvsimple requires it); pvr.iptvsimple: Live TV.
BINARY_ADDONS="inputstream.adaptive inputstream.ffmpegdirect inputstream.rtmp pvr.iptvsimple"

# BingeTV's version: shown in its update notices, and the tag of its GitHub release.
BINGETV_VERSION=0.2.2
BINGETV_RELEASES=https://api.github.com/repos/shiggsy365/BingeTV/releases/latest

# Add-ons built into the APK (tools/bundle_addons.py). Kodi turns them on at the first
# start (patches/0002 lists them in system/addon-manifest.xml); repository.shiggsy365
# keeps ours up to date, Kodi's repository Up Next and YouTube.
OURS_REPO=https://github.com/shiggsy365/KodiStremioBridge.git
OURS_REF=db7a9ffbffcb0dec0ec7c6eab13cfde8fca15bfa
OURS_ADDONS="plugin.video.stremiobridge skin.bingetv script.shiggsy365.dispatcharrbridge service.shiggsy365.tidycache repository.shiggsy365"
KODI_ADDON_MIRROR=https://mirrors.kodi.tv/addons/piers
KODI_REPO_ADDONS="service.upnext plugin.video.youtube"
